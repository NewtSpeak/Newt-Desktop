{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "newt-desktop",
  "version": "0.2.0",
  "identifier": "com.newtspeak.desktop",
  "build": {
    "frontendDist": "../build/client",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Newt Desktop",
        "width": 1280,
        "height": 720,
        "minWidth": 940,
        "minHeight": 500,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "additionalBrowserArgs": "--proxy-server=direct:// --proxy-bypass-list=<-loopback>;127.0.0.1;localhost --disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection"
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/tray-icon.png",
      "iconAsTemplate": false,
      "tooltip": "NewtSpeak",
      "showMenuOnLeftClick": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 26,
      "debugApplicationIdSuffix": ".debug"
    },
    "macOS": {
      "entitlements": "./Entitlements.plist"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["newtspeak"]
      },
      "mobile": [
        {
          "scheme": ["newtspeak"]
        }
      ]
    }
  }
}
