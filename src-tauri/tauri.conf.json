{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "owl-desktop",
  "version": "0.1.0",
  "identifier": "com.owlspeak.desktop",
  "build": {
    "frontendDist": "../build/client",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Owl Desktop",
        "width": 1280,
        "height": 720,
        "minWidth": 940,
        "minHeight": 500,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "macOS": {
      "entitlements": "./Entitlements.plist"
    }
  }
}
